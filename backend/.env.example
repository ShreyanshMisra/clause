GEMINI_API_KEY=your_key
# Adjudication model — the strong model used for clause analysis & the demand letter.
GEMINI_MODEL=gemini-3.1-pro-preview
# Cheap/fast model for extraction-style steps (metadata, PII assist).
GEMINI_FAST_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-001
# Sampling temperature for generation. 0 = deterministic (preferred for consistency).
GEMINI_TEMPERATURE=0
VECTOR_BACKEND=local
# Secret used to sign session tokens. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=CLAUSE_WH
SNOWFLAKE_DATABASE=CLAUSE_DB
SNOWFLAKE_SCHEMA=PUBLIC
ALLOWED_ORIGINS=http://localhost:3000